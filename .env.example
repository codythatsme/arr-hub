# Required for production. Generate a stable value with:
# openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-stable-random-secret
INITIAL_ADMIN_PASSWORD=change-me-before-first-login

# Optional emergency password recovery token. Leave empty unless recovering
# access, set to a temporary random value, restart, reset the password from
# the login screen, then clear it and restart again.
ARR_HUB_PASSWORD_RECOVERY_TOKEN=

# Required for movie/TV metadata lookup, add flows, and refresh jobs.
TMDB_API_KEY=replace-me-with-your-tmdb-api-key

# Compose bind mounts. Use host paths that already exist on NAS/Linux hosts
# when you need predictable ownership and ACL behavior.
ARR_HUB_DOWNLOADS_PATH=./downloads
ARR_HUB_MOVIES_PATH=./media/movies
ARR_HUB_TV_PATH=./media/tv

# Optional in-container path for scheduler-created SQLite backup snapshots.
ARR_HUB_BACKUP_PATH=/data/backups

# Optional deployment metadata for System health update-available diagnostics.
# ARR Hub does not self-update; use this to surface a newer released version.
ARR_HUB_LATEST_VERSION=

# Optional live common indexer validation. Prefer setting real values in
# .env.local, then run `bun run test:live-common-indexers`.
ARR_HUB_REQUIRE_LIVE_COMMON_INDEXERS=
ARR_HUB_LIVE_NZBGEEK_URL=https://api.nzbgeek.info
ARR_HUB_LIVE_NZBGEEK_API_KEY=
ARR_HUB_LIVE_DRUNKENSLUG_URL=https://drunkenslug.com
ARR_HUB_LIVE_DRUNKENSLUG_API_KEY=
ARR_HUB_LIVE_NZBFINDER_URL=https://nzbfinder.ws
ARR_HUB_LIVE_NZBFINDER_API_KEY=
ARR_HUB_LIVE_OPTIONAL_NEWZNAB_NAME=
ARR_HUB_LIVE_OPTIONAL_NEWZNAB_URL=
ARR_HUB_LIVE_OPTIONAL_NEWZNAB_API_KEY=
ARR_HUB_LIVE_TORRENT_NAME=
ARR_HUB_LIVE_TORRENT_URL=
ARR_HUB_LIVE_TORRENT_API_KEY=
ARR_HUB_LIVE_COMMON_USENET_QUERY=matrix
ARR_HUB_LIVE_COMMON_TORRENT_QUERY=ubuntu
